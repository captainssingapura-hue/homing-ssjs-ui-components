        <artifactId>homing-components</artifactId>
        <version>LOCAL-SNAPSHOT</version>
    </parent>

    <artifactId>homing-ui-control-panel</artifactId>

    <description>
        Controllability on a page: the house's control catalogue as the page has it - every option
        with how it is controlled and the method that applies it, every control type, and every
        leaf's type - generated from the declarations; the helper that applies an option to what is
        controlled; and the control panel, which makes the control each option's means calls for -
        a slider for a degree, a toggle for a switch, a button for an action or a question.
    </description>

    <dependencies>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-core</artifactId>
            <version>${homing.core.version}</version>
        </dependency>

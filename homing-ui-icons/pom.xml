<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.captainssingapura-hue.homing.js</groupId>
        <artifactId>homing-components</artifactId>
        <version>LOCAL-SNAPSHOT</version>
    </parent>

    <artifactId>homing-ui-icons</artifactId>
    <description>
        Icons: a mark that means something - check, close, detach, rotate -
        and never says what it looks like. An Icon word of the design
        vocabulary, worn on a mark element through the Glyph target; the
        design draws the picture. One element component, Icon, and one
        generated table of the words. RFC 0066 Episode 3, appendix Context
        Menus, section on icons.
    </description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- What it provides for styles (The Style Jars): the style's record, and the colour tree its implementations import. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-style-base</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ui-colours</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <!-- The taxonomy its components are anchored at: each module ImplFor its leaf. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ui-taxonomy</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <!-- The house's look - the design's: the lexicon an icon shows a word of, and the sheet each style writes them in. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ui-look</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-core</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-core-js</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-component-base</artifactId>
            <version>${homing.core.version}</version>
        </dependency>

        <!-- The jar's own instance, which its JS tests install (D51). -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ui-jar-instance</artifactId>
            <version>${project.parent.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-conformance-rules</artifactId>
            <version>${homing.core.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ssjs-test-fixtures</artifactId>
            <version>${homing.core.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>

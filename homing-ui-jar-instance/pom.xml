        <artifactId>homing-components</artifactId>
        <version>LOCAL-SNAPSHOT</version>
    </parent>

    <artifactId>homing-ui-jar-instance</artifactId>

    <description>
        RFC 0067, D51 - a house jar's own instance, for its tests (JarInstance): the jar's component modules and those of

# A sketch of a theme over the house taxonomy, answering the button family with what it says:
# Editorial's sizes and motion in Harbour's colours, light. A coloured button's surface and ink
# move with its extent: the word at 1, the neutral at 0, the meaning turned the other way at -1.

# ── the roots: a theme answers every target at the root ────────────────────
root  rest  color-surface      { background-color: transparent; }
root  rest  color-ink          { color: inherit; }
root  rest  color-edge         { border-color: currentColor; outline-color: currentColor; }
root  rest  color-fill         { fill: currentColor; }
root  rest  color-stroke       { stroke: none; }
root  rest  color-scrollbar    { scrollbar-color: auto; }
root  rest  shape-corner       { border-radius: 0; }
root  rest  shape-rule         { border-width: 0; border-style: solid; outline-style: none; }
root  rest  shape-shadow       { box-shadow: none; }
root  rest  shape-clip         { clip-path: none; }
root  rest  size-inset         { padding-block: 0; padding-inline: 0; }
root  rest  size-gap           { gap: normal; }
root  rest  size-extent        { min-height: auto; min-width: auto; }
root  rest  size-proportion    { aspect-ratio: auto; }
root  rest  type-face          { font-family: inherit; }
root  rest  type-weight        { font-weight: inherit; }
root  rest  type-scale         { font-size: inherit; line-height: inherit; }
root  rest  type-treatment     { letter-spacing: normal; }
root  rest  type-decoration    { text-decoration-line: none; }
root  rest  type-glyph
root  rest  motion-ease        { transition: none; }
root  rest  motion-transform   { transform: none; }
root  rest  motion-animate     { animation: none; }
root  rest  effect-opacity     { opacity: 1; }
root  rest  effect-filter      { filter: none; }
root  rest  effect-blend       { mix-blend-mode: normal; }
root  rest  affordance-cursor  { cursor: auto; }
root  rest  affordance-select  { user-select: auto; }
root  rest  sound-cue
root  rest  asset-icon
root  rest  asset-illustration

# ── every control: pointed at, ringed on focus, and how it is when it cannot be used ──
control  rest      affordance-cursor  { cursor: pointer; }
control  focus     shape-rule         { outline-width: 2px; outline-style: solid; outline-offset: -2px; }
control  disabled  effect-opacity     { opacity: .45; }
control  disabled  affordance-cursor  { cursor: default; }

# ── the button: its frame, its measure growing a step of 1.3 per unit of size ──
button  rest  shape-corner  { border-radius: 3px; }
button  rest  shape-rule    { border-width: 1.5px; border-style: solid; }
button  rest  color-edge    { border-color: #E2E8F0; outline-color: #1E2761; }
button  rest  size-inset    {
    padding-block: calc(8px * pow(1.3, var(--size)));
    padding-inline: calc(18px * pow(1.3, var(--size)));
}
button  rest  size-gap      { gap: calc(8px * pow(1.3, var(--size))); }
button  rest  size-extent   { min-width: calc(56px * pow(1.3, var(--size))); }
button  rest  type-weight   { font-weight: 600; }
button  rest  type-scale    { font-size: calc(14px * pow(1.25, var(--size))); line-height: 1.2; }
button  rest  motion-ease   { transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease; }
button  rest  shape-shadow  { box-shadow: 0 1px 3px rgba(17, 25, 54, .04); }

# ── lifted under the hand, set down when pressed, flat when it cannot be used ──
button  hover     shape-shadow      { box-shadow: 0 6px 16px rgba(17, 25, 54, .12); }
button  hover     motion-transform  { transform: translateY(-2px); }
button  disabled  shape-shadow      { box-shadow: none; }
button  disabled  motion-transform  { transform: none; }
button  active    shape-shadow      { box-shadow: 0 1px 2px rgba(17, 25, 54, .08); }
button  active    motion-transform  { transform: translateY(0); }

# ── each button's rank: its surface, its ink, its edge ─────────────────────
plain-button      rest  color-surface  { background-color: #FFFFFF; }
plain-button      rest  color-ink      { color: #3B4A6B; }
primary-button    rest  color-surface  {
    background-color: color-mix(in srgb, #1E2761 calc(clamp(0, var(--extent), 1) * 100%),
                                color-mix(in srgb, #E2E8F0 calc((1 + clamp(-1, var(--extent), 0)) * 100%), transparent));
}
primary-button    rest  color-ink      { color: color-mix(in srgb, #FFFFFF calc(clamp(0, var(--extent), 1) * 100%), #3B4A6B); }
primary-button    rest  color-edge     { border-color: #1E2761; outline-color: #F4B942; }
secondary-button  rest  color-surface  {
    background-color: color-mix(in srgb, #F4B942 calc(clamp(0, var(--extent), 1) * 100%),
                                color-mix(in srgb, #E2E8F0 calc((1 + clamp(-1, var(--extent), 0)) * 100%), transparent));
}
secondary-button  rest  color-ink      { color: #111936; }
secondary-button  rest  color-edge     { border-color: #C8921E; outline-color: #1E2761; }
danger-button     rest  color-surface  {
    background-color: color-mix(in srgb, rgba(220, 38, 38, .10) calc(clamp(0, var(--extent), 1) * 100%),
                                color-mix(in srgb, rgba(34, 139, 34, .12) calc(clamp(0, calc(-1 * var(--extent)), 1) * 100%), transparent));
}
danger-button     rest  color-ink      {
    color: color-mix(in srgb, #7F1D1D calc(clamp(0, var(--extent), 1) * 100%),
                     color-mix(in srgb, #1B5E20 calc(clamp(0, calc(-1 * var(--extent)), 1) * 100%), #3B4A6B));
}
danger-button     rest  color-edge     { border-color: rgba(220, 38, 38, .35); outline-color: #7F1D1D; }
warning-button    rest  color-surface  {
    background-color: color-mix(in srgb, rgba(202, 138, 4, .12) calc(clamp(0, var(--extent), 1) * 100%),
                                color-mix(in srgb, rgba(34, 139, 34, .12) calc(clamp(0, calc(-1 * var(--extent)), 1) * 100%), transparent));
}
warning-button    rest  color-ink      { color: #713F12; }
success-button    rest  color-surface  {
    background-color: color-mix(in srgb, rgba(34, 139, 34, .12) calc(clamp(0, var(--extent), 1) * 100%),
                                color-mix(in srgb, rgba(220, 38, 38, .10) calc(clamp(0, calc(-1 * var(--extent)), 1) * 100%), transparent));
}
success-button    rest  color-ink      { color: #1B5E20; }

# ── a different shape for the danger button ────────────────────────────────
danger-button  rest  shape-corner  { border-radius: 2px; }

# ── the primary button as Go leads a little harder ────────────────────────
primary-button_go  rest  type-weight  { font-weight: 700; }
